# App Configuration
APP_NAME="Go Backend Template API"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_URL=http://localhost:8000
APP_DEBUG=false
APP_REQUEST_TIMEOUT=10s
APP_SHUTDOWN_TIMEOUT=10s
APP_SHUTDOWN_WAIT=200ms
APP_PROMETHEUS=false
APP_RATE_LIMIT_PER_SECOND=20
APP_RATE_LIMIT_IP_PER_SECOND=200
APP_PUBLIC_API_KEY=
BASE_URL_CV=http://127.0.0.1:5009/api/v1
MODEL_STORAGE_DIR=storage/models

# Logging
LOG_DIR=logs
LOG_FILE=app.txt

# DB Connection
DB_DRIVER=postgresql
DB_HOST=127.0.0.1
# Host/WSL port when PostgreSQL is started by docker-compose.
# The app container overrides this to 5432 internally.
DB_PORT=5437
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_MAX_LIFETIME_CONN=10m
DB_MAX_CONN_IDLE_TIME=5m
DB_KEEP_ALIVE_INTERVAL_CONN=5m

# SQLite benchmark example (DB_SCHEMA is a file path; host/user/password are not needed)
# DB_DRIVER=sqlite
# DB_SCHEMA=./build/navi-benchmark.db
# DB_MAX_OPEN_CONNS=30
# DB_MAX_IDLE_CONNS=30
# Then run: make sqlite.setup

# Auth Option
AUTH_ACCESS_TOKEN_SECRET_KEY=secret-key
AUTH_ACCESS_TOKEN_EXPIRES=24h
AUTH_REFRESH_TOKEN_SECRET_KEY=secret-key
AUTH_REFRESH_TOKEN_EXPIRES=48h
AUTH_BCRYPT_COST=10

# First-boot superadmin bootstrap. The seeder hashes the password before storing it.
DEFAULT_ADMIN_EMAIL=superadmin@gmail.com
DEFAULT_ADMIN_PASSWORD=

# Swagger
SWAGGER_ENABLED=true
SWAGGER_HOST=localhost:8000
SWAGGER_BASE_PATH=/api/v1
# Comma-separated service names. Leave empty to include all services.
SWAGGER_SERVICES=
