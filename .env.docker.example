# Copy this file to .env on the development server before starting Compose.

APP_NAME="NAVI Backend API"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http://YOUR_SERVER_IP:8000
APP_DEBUG=false
APP_REQUEST_TIMEOUT=10s
APP_SHUTDOWN_TIMEOUT=10s
APP_SHUTDOWN_WAIT=200ms
APP_PROMETHEUS=false
APP_RATE_LIMIT_PER_SECOND=20
APP_RATE_LIMIT_IP_PER_SECOND=200
APP_PUBLIC_API_KEY=

# Docker Compose PostgreSQL
DB_DRIVER=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=navi
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DB_SCHEMA=navi
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_MAX_LIFETIME_CONN=10m
DB_MAX_CONN_IDLE_TIME=5m
DB_KEEP_ALIVE_INTERVAL_CONN=5m

AUTH_ACCESS_TOKEN_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
AUTH_ACCESS_TOKEN_EXPIRES=24h
AUTH_REFRESH_TOKEN_SECRET_KEY=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
AUTH_REFRESH_TOKEN_EXPIRES=48h
AUTH_BCRYPT_COST=10

DEFAULT_ADMIN_EMAIL=superadmin@gmail.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME

BASE_URL_CV=http://host.docker.internal:5009/api/v1/
MODEL_STORAGE_DIR=/app/storage/models
LOG_DIR=/app/logs
LOG_FILE=app.txt

SWAGGER_ENABLED=true
SWAGGER_HOST=YOUR_SERVER_IP:8000
SWAGGER_BASE_PATH=/api/v1
SWAGGER_SERVICES=
